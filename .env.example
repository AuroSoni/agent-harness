# agent-base library — example environment.
#
# Legend:  (required) = must be set   ·   (optional) = has a safe default,
# override only if needed. Commented "# KEY=" lines are OPTIONAL. Sensitive
# values are placeholders — never commit real secrets.
#
# Almost everything here is OPTIONAL: agent-base reads only the S3 region/
# endpoint group directly (agent_base/blob_store/s3_config.py); the rest is
# resolved by the underlying SDK (anthropic / litellm / boto3) or passed
# programmatically by the consumer, and is documented here as convention.

# ── Anthropic ────────────────────────────────────────────────────────
# (required for live runs) Consumed by the anthropic SDK inside AnthropicAgent
# when no client is injected — the default Anthropic provider path.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── LiteLLM / OpenAI (optional) ──────────────────────────────────────
# (optional) Only when using the litellm provider WITHOUT an explicit config
# api_key — litellm then resolves the provider key from env (e.g. OPENAI_API_KEY).
# OPENAI_API_KEY=

# ── PostgreSQL storage backend (optional) ────────────────────────────
# (optional) The pg backend (PgPool / ensure_all_schemas) takes a DSN passed
# programmatically by the consumer; agent-base does not read this env itself.
# DATABASE_URL=postgresql://user:password@localhost:5432/anthropic_agent

# ── S3 blob / media backend (optional) ───────────────────────────────
# The region/endpoint keys below ARE read directly by S3Settings.from_env when
# a consumer wires an S3 store. AWS credentials are resolved by the boto3
# default credential chain (not read here).
# AWS_ACCESS_KEY_ID=your_aws_access_key_id       # (optional) required only for S3 backends
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key  # (optional) required only for S3 backends
# Region precedence: S3_REGION > AWS_REGION > AWS_DEFAULT_REGION.
# (agent-base's built-in fallback, if none are set, is us-east-1.)
# S3_REGION=                       # (optional)
# AWS_REGION=                      # (optional)
# AWS_DEFAULT_REGION=ap-south-1    # (optional) default region
# S3_ENDPOINT_URL=                 # (optional) custom / S3-compatible endpoint (e.g. MinIO)
# S3_BUCKET=your-bucket-name       # (optional) the bucket var NAME is caller-supplied; S3_BUCKET is the convention
